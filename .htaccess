# Sem listagem de pastas
Options -Indexes

# Nunca servir o repositório Git nem arquivos de apoio pela web
RedirectMatch 404 /\.git
<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>
<FilesMatch "(\.(bak|log|ps1)|\.bak-[^/]*)$">
    Require all denied
</FilesMatch>
<FilesMatch "^config\.example\.php$">
    Require all denied
</FilesMatch>

# A URL limpa da pasta (a pasta do painel) precisa abrir o index.php
DirectoryIndex index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ index.php [L]
</IfModule>
